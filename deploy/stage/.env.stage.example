# Copy to deploy/stage/.env.stage on the stage host and fill every value.
# .env.stage is never committed (.gitignore). Generate values with:
#   openssl rand -hex 24
# Hex keeps passwords safe inside URLs, YAML and shell commands.

# Gateway port on 127.0.0.1; the host nginx proxies the stage domain to it.
GATEWAY_PORT=8088

POSTGRES_USER=rankr_admin
POSTGRES_PASSWORD=
POSTGRES_DB=rankr

AUTH_USER=auth_user
AUTH_PASS=
CONTRIBUTOR_USER=contributor_user
CONTRIBUTOR_PASS=
LEADERBOARDSCORING_USER=leaderboardscoring_user
LEADERBOARDSCORING_PASS=
LEADERBOARDSTAT_USER=leaderboardstat_user
LEADERBOARDSTAT_PASS=
PROJECT_USER=project_user
PROJECT_PASS=
WEBHOOK_USER=webhook_user
WEBHOOK_PASS=

# Databases for services that stage does not run yet (required by
# init-services-db.sh).
NOTIFAPP_USER=notification_user
NOTIFAPP_PASS=
REALTIME_USER=realtime_user
REALTIME_PASS=
TASK_USER=task_user
TASK_PASS=

REDIS_PASSWORD=

# Shared secret for GitHub webhook HMAC verification. Must equal the secret
# configured on the GitHub webhook. Webhook refuses to start without it.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# JWT signing key for authapp (at least 32 characters).
JWT_SECRET=
