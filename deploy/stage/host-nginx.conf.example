# Host nginx vhost for stage. Copy to /etc/nginx/sites-available/rankr-stage,
# set server_name, enable it, then run:
#   certbot --nginx -d <stage domain>
# The gateway listens on 127.0.0.1:GATEWAY_PORT (8088 by default).
server {
    listen 80;
    listen [::]:80;
    server_name stage.rankr.gocasts.ir;

    client_max_body_size 5m;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
